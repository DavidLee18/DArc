#!/usr/bin/env bash
# Cross-compile DArc to 64-bit Windows via the MicroHs combinator-VM.
# Uses mhs -tenvironment to redirect C codegen through a mingw-w64 toolchain.
#
# Target architecture is DARC_WIN_ARCH (default x86_64); see compile-win64-c
# for what each value selects and why. Output:
#
#   x86_64    Tests/arc-mhs-win64.exe        (~2.7MB vs 22MB for the GHC build)
#   aarch64   Tests/arc-mhs-win-arm64.exe
#
# The x86_64 name is left exactly as it was so the existing CI jobs, release
# packaging and Tests/win-test.sh default keep working untouched.
set -e

arch=${DARC_WIN_ARCH:-x86_64}
case "$arch" in
  x86_64)  triple="x86_64-w64-mingw32";  toolchain=gcc;  sfx="win64"     ;;
  aarch64) triple="aarch64-w64-mingw32"; toolchain=llvm; sfx="win-arm64" ;;
  *) echo "error: DARC_WIN_ARCH must be x86_64 or aarch64, got '$arch'" >&2; exit 2 ;;
esac

# See compile-win64-c: lets a target be built with the other toolchain, to
# separate compiler-specific from architecture-specific behaviour.
case "${DARC_WIN_TOOLCHAIN:-}" in
  "")        ;;
  gcc|llvm)  toolchain="$DARC_WIN_TOOLCHAIN" ;;
  *) echo "error: DARC_WIN_TOOLCHAIN must be gcc or llvm, got '$DARC_WIN_TOOLCHAIN'" >&2; exit 2 ;;
esac
# Debian's mingw uses "-posix" to pick the threading model; llvm-mingw has no
# such variants, so the driver name has no suffix there.
case "$toolchain" in gcc) cc_suffix="-posix" ;; llvm) cc_suffix="" ;; esac

exe=Tests/arc-mhs-$sfx.exe
gui_flag=""
for option; do
  case $option in
    -DFREEARC_GUI) exe=Tests/freearc-mhs-$sfx.exe; gui_flag="-DFREEARC_GUI" ;;
    -O*) echo "warning: ignoring optimization flag '$option' for mhs build" >&2 ;;
  esac
done

WINOUT=${WINOUT:-/tmp/out/FreeArc-win64-mhs-$arch-$toolchain}
mkdir -p "$WINOUT"

# ── Optional Rust codecs, cross-compiled for the Windows target ──────────────
#
# DARC_RUST=1 builds rust/darc-codecs + darc-crypto for this target and links
# them, the same switch ./compile offers natively. This must run BEFORE any C is
# compiled: the codec headers key off DARC_RUST, so adding the define after
# compile-win64-c would leave the C++ symbols bound while the staticlibs sat
# unused in the link -- the mistake ./compile documents at length.
#
# Two crates in the tree compile C of their own (zstd-sys) or parse DArc's
# headers with clang (bindgen), so both need the CROSS toolchain, not the host's:
#
#   CC_<target>                      cc-rs, for zstd-sys' vendored C
#   AR_<target>                      the matching archiver
#   BINDGEN_EXTRA_CLANG_ARGS_<target>  so clang finds the mingw headers
#
# The bindgen args matter for correctness, not just for finding stdio.h:
# `long` is 4 bytes on Windows and 8 on LP64, so bindings generated against the
# HOST would be silently wrong about every long in the ABI. That is the same
# long-width family of bugs this repository has fixed a dozen times, so the
# target is passed explicitly rather than left to default.
rust_libs=""
if [ -n "${DARC_RUST:-}" ]; then
  command -v cargo >/dev/null 2>&1 ||
    { echo "error: DARC_RUST is set but cargo was not found in PATH" >&2; exit 1; }

  case "$arch" in
    x86_64)  rust_target="x86_64-pc-windows-gnu"      ;;
    aarch64) rust_target="aarch64-pc-windows-gnullvm" ;;
  esac

  if ! rustup target list --installed 2>/dev/null | grep -qx "$rust_target"; then
    echo "adding Rust target $rust_target"
    rustup target add "$rust_target" ||
      { echo "error: could not add Rust target $rust_target" >&2; exit 1; }
  fi

  # Same compiler compile-win64-c picked, but the C driver rather than the C++.
  # Debian's mingw-w64 suffixes the driver with the threading model; Homebrew's
  # and llvm-mingw do not ship those variants, so fall back to the plain name
  # rather than failing on a host whose toolchain is simply laid out differently.
  rust_cc="$triple-gcc$cc_suffix"
  command -v "$rust_cc" >/dev/null 2>&1 || rust_cc="$triple-gcc"
  command -v "$rust_cc" >/dev/null 2>&1 ||
    { echo "error: neither $triple-gcc$cc_suffix nor $triple-gcc found -- needed to cross-compile the Rust codecs" >&2; exit 1; }
  rust_ar="$triple-ar"

  # Ask the cross compiler for its own header search path rather than deriving
  # one from its location. Debian's mingw-w64, Homebrew's and llvm-mingw lay
  # these out differently, and on Homebrew the driver on PATH is a symlink into
  # the Cellar, so walking up from it lands somewhere with no headers at all --
  # which fails as "stdio.h not found" only once bindgen runs.
  rust_incs=""
  while IFS= read -r d; do
    [ -d "$d" ] && rust_incs="$rust_incs -I$d"
  done < <(printf '' | "$rust_cc" -E -Wp,-v - 2>&1 | sed -n 's/^ \(\/.*\)$/\1/p')
  [ -n "$rust_incs" ] ||
    { echo "error: $rust_cc reported no include directories -- cannot configure bindgen" >&2; exit 1; }

  # Env-var suffix is the target triple with - turned into _, and left LOWER
  # case: cc-rs and bindgen both look the target up as written. Upper-casing it
  # makes every one of these silently not match, which shows up only as bindgen
  # failing to find stdio.h -- the host compiler having been used instead.
  rt_env=$(echo "$rust_target" | tr '-' '_')
  export "CC_${rt_env}=$rust_cc"
  export "AR_${rt_env}=$rust_ar"
  export "BINDGEN_EXTRA_CLANG_ARGS_${rt_env}=--target=$triple$rust_incs"

  # bindgen parses DArc's headers as C++ (build.rs passes -x c++), so it reads
  # the toolchain's C++ standard library. llvm-mingw ships libc++ headers that
  # use builtins such as __builtin_clzg, which only a matching clang knows --
  # bindgen's default libclang is older and fails on them. Use the cross
  # toolchain's own libclang, which by construction matches its own headers.
  if [ "$toolchain" = llvm ]; then
    llvm_bin=$(dirname "$(command -v "$triple-clang" 2>/dev/null || command -v "$rust_cc")")
    for d in "$llvm_bin/../lib" "$llvm_bin/../lib64"; do
      if ls "$d"/libclang.so* >/dev/null 2>&1 || ls "$d"/libclang.dylib >/dev/null 2>&1; then
        export LIBCLANG_PATH=$(cd "$d" && pwd); break
      fi
    done
    [ -n "${LIBCLANG_PATH:-}" ] &&
      echo "using $LIBCLANG_PATH/libclang for bindgen (matches llvm-mingw's libc++)"
  fi

  echo "building Rust codecs and crypto for $rust_target"
  ( cd rust && cargo build --release -p darc-codecs -p darc-crypto \
      --features darc-codecs/dropin --target "$rust_target" ) ||
    { echo "error: cargo build failed for $rust_target" >&2; exit 1; }

  rust_libs="$PWD/rust/target/$rust_target/release/libdarc_codecs.a"
  rust_libs="$rust_libs $PWD/rust/target/$rust_target/release/libdarc_crypto.a"
  for l in $rust_libs; do
    [ -f "$l" ] || { echo "error: cargo produced no $l" >&2; exit 1; }
  done

  # Reaches the per-codec makefiles through win32-common.mak; make imports it.
  export DARC_EXTRA_DEFINES="-DDARC_RUST"
fi

# 1) Build C/C++ objects for the Windows target with __MHS__ defined
MHS=1 WINOUT="$WINOUT" DARC_WIN_ARCH="$arch" DARC_WIN_TOOLCHAIN="$toolchain" ./compile-win64-c

# 2) ntrljmp.c for Lua trampoline (Lua not used on MHS path — skip unless GUI/Lua needed)
# We don't link Lua under MHS for now; HsLua bindings only used by GHC build.

# 3) MHS cross-compile setup
# mhs targets.conf has [environment] block that pulls cc/ccflags/cclibs/conf from env vars
defines="-DFREEARC_WIN -DFREEARC_INTEL_BYTE_ORDER -DFREEARC_64BIT -DFREEARC_NOURL -DFREEARC_NO_LUA"
[ -n "${DARC_RUST:-}" ] && defines="$defines -DDARC_RUST"

c_objs=(
  "$WINOUT/Environment.o" "$WINOUT/URL.o" "$WINOUT/Common.o"
  "$WINOUT/CompressionLibrary.o"
  "$WINOUT/C_PPMD.o" "$WINOUT/C_LZP.o" "$WINOUT/C_LZMA.o" "$WINOUT/C_LZMA2.o" "$WINOUT/C_LZ4.o"
  "$WINOUT/C_GRZip.o" "$WINOUT/C_BSC.o" "$WINOUT/C_Zstd.o" "$WINOUT/C_DisPack.o"
  "$WINOUT/C_Dict.o" "$WINOUT/C_REP.o"
  "$WINOUT/C_MM.o" "$WINOUT/C_TTA.o" "$WINOUT/C_Tornado.o"
  "$WINOUT/C_4x4.o" "$WINOUT/C_Delta.o" "$WINOUT/C_External.o"
  "$WINOUT/C_Encryption.o"
  "$WINOUT/LzmaEnc.o" "$WINOUT/LzmaDec.o" "$WINOUT/Lzma2Enc.o" "$WINOUT/Lzma2Dec.o"
  "$WINOUT/LzFind.o" "$WINOUT/LzFindMt.o" "$WINOUT/LzFindOpt.o"
  "$WINOUT/CpuArch.o" "$WINOUT/Alloc.o" "$WINOUT/Threads.o"
  "$WINOUT/MtCoder.o" "$WINOUT/MtDec.o" "$WINOUT/7zStream.o"
  "$WINOUT/C_7z.o"
  "$WINOUT/sdk_7zArcIn.o" "$WINOUT/sdk_7zBuf.o" "$WINOUT/sdk_7zCrc.o"
  "$WINOUT/sdk_7zCrcOpt.o" "$WINOUT/sdk_7zDec.o" "$WINOUT/sdk_7zFile.o"
  "$WINOUT/sdk_7zStream.o" "$WINOUT/sdk_7zAlloc.o"
  "$WINOUT/sdk_Bcj2.o" "$WINOUT/sdk_Bra.o" "$WINOUT/sdk_Bra86.o" "$WINOUT/sdk_BraIA64.o"
  "$WINOUT/sdk_Delta.o" "$WINOUT/sdk_LzmaDec.o" "$WINOUT/sdk_Lzma2Dec.o"
  "$WINOUT/sdk_Ppmd7.o" "$WINOUT/sdk_Ppmd7Dec.o"
  "$WINOUT/sdk_CpuArch.o" "$WINOUT/sdk_Alloc.o"
)
[[ -f "$WINOUT/C_BCJ.o" ]] && c_objs+=("$WINOUT/C_BCJ.o")
for zo in "$WINOUT"/zstd_*.o; do [[ -f "$zo" ]] && c_objs+=("$zo"); done

# Windows system libs (mingw provides these).
#
# The link is driven by the C compiler, not the C++ one, so the C++ runtime has
# to be named explicitly -- and the two toolchains do not ship the same one.
# GCC-mingw has libstdc++; llvm-mingw has LLVM's libc++, which additionally
# needs libc++abi and libunwind when linked statically. Asking for -lstdc++
# under llvm-mingw fails outright, so this is not a preference.
case "$toolchain" in
  gcc)  cxx_libs="-lstdc++ -lpthread" ;;
  llvm) cxx_libs="-lc++ -lc++abi -lunwind" ;;
esac
win_libs="-static $cxx_libs -lwinpthread -lwinmm -lws2_32 -ladvapi32 -lshell32 -luser32 -lkernel32 -lwininet -Wl,--allow-multiple-definition"
# Rust's std imports Windows APIs the C side never touched: the Nt*/Rtl* native
# calls live in ntdll, GetUserProfileDirectoryW in userenv, and its RNG in
# bcrypt. Without these the link fails with a wall of "undefined reference to
# NtOpenFile / RtlNtStatusToDosError". Only added under DARC_RUST so the pure-C
# link line stays exactly as it was.
[ -n "${DARC_RUST:-}" ] && win_libs="$win_libs -lntdll -luserenv -lbcrypt"

# Build MHSCCLIBS from C objects (one space-separated string)
linker_inputs=""
for o in "${c_objs[@]}"; do linker_inputs="$linker_inputs $o"; done

export CC="$triple-gcc$cc_suffix"
command -v "$CC" >/dev/null 2>&1 ||
  { echo "error: $CC not found in PATH" >&2; exit 2; }
# Everything below makes up for what runtime/mingw/config.h does not provide.
# See the MHSCONF note further down for why neither shipped config works alone.

# Feature switches that runtime/unix/config.h sets and runtime/mingw/config.h
# does not. Each omission surfaces only at *runtime*, as a primitive missing
# from the FFI table -- WANT_DIR shows up as "ERR: FFI unknown opendir" the
# moment DArc scans a directory -- so they are supplied as a set rather than
# discovered one crash and one 10-minute build at a time. mingw-w64 has the
# headers behind all of them. ISWINDOWS backs the runtime's iswindows() query,
# which is how Haskell code detects the platform.
runtime_defs="-DWANT_FLOAT32=1 -DWANT_FLOAT64=1 -DWANT_INT64=1"
runtime_defs="$runtime_defs -DWANT_DIR=1 -DWANT_TIME=1 -DWANT_FD=1"
runtime_defs="$runtime_defs -DISWINDOWS=1"

# A clock, and a one-argument mkdir. Both are Unix-only upstream: without the
# clock every threadDelay dies with "ERR: threadDelay: no clock", which is fatal
# for DArc's all-concurrent pipeline, and WANT_DIR makes the runtime call POSIX
# two-argument mkdir, which mingw does not have. See compat-win/mhs_win_compat.h.
# All of these are plain identifier macros, so none of it needs shell quoting.
runtime_defs="$runtime_defs -include compat-win/mhs_win_compat.h"
runtime_defs="$runtime_defs -DCLOCK_T=int64_t -DCLOCK_INIT=darc_mhs_clock_init"
runtime_defs="$runtime_defs -DCLOCK_GET=darc_mhs_clock_get -DCLOCK_SLEEP=usleep"
# What the two toolchains need that the other does not. Both of the aarch64
# entries are about Clang rather than about ARM64 -- llvm-mingw is simply the
# only toolchain that targets it -- so if a Clang x86-64 mingw build is ever
# added, it wants this same set.
#
#   -static-libgcc/-static-libstdc++  name GCC's runtimes. Clang accepts the
#     flags but has neither, so it warns about an unused argument on every
#     single file it compiles.
#
#   -include errno.h  mhs generates errno accessors (mhs_EACCES and friends)
#     that reference the macros without including <errno.h> themselves. That
#     header happens to be reached transitively under Debian's mingw-w64
#     headers and is not under llvm-mingw's, where the build stops with
#     "use of undeclared identifier 'EACCES'". Force-including it costs
#     nothing and does not depend on which chain pulls it in.
#
#   -Wno-incompatible-function-pointer-types  mhs's FFI glue passes HsFunPtr,
#     i.e. void(*)(void), straight into CompressionService's CALLBACK_FUNC*
#     parameter without a cast. GCC warns; Clang 16 and later reject it. The
#     pointer really is a callback of the right shape at run time -- see the
#     foreign-export machinery in Compression/CompressionLib.hs -- so this is
#     a missing cast in generated code, not a real mismatch.
case "$toolchain" in
  gcc)
    cc_quirks="-static-libgcc -static-libstdc++" ;;
  llvm)
    cc_quirks="-include errno.h -Wno-incompatible-function-pointer-types" ;;
esac
export MHSCCFLAGS="-O2 $cc_quirks -I. -ICompression -IHsLua/src $runtime_defs $defines $gui_flag"
export MHSCCLIBS="$linker_inputs $rust_libs $win_libs"
# Neither MicroHs runtime config fits a mingw cross-build on its own, so use
# "mingw" and supply what it is missing (see runtime_defs above).
#
#   runtime/mingw/config.h   GCC-oriented (__builtin_ffsll/clzll/ctzll), which
#                            is what this toolchain needs -- but stale: it sets
#                            the pre-rename WANT_FLOAT and defines neither
#                            WANT_FLOAT32/WANT_FLOAT64 nor WANT_INT64, so
#                            eval.c fails with "'union <anonymous>' has no
#                            member named 'uuflt32value'".
#
#   runtime/windows/config.h current names, but written for MSVC: it pulls in
#                            <intrin.h> and <Windows.h> with a capital W. mingw
#                            ships lowercase windows.h, and cross-compiling on
#                            Linux is case-sensitive, so it fails with
#                            "Windows.h: No such file or directory".
#
# Both observed on MicroHs 0.15.4.0, the commit CI pins. Upstream inconsistency,
# not something this repo introduced.
export MHSCONF="mingw"

# 4) Run mhs with -tenvironment
rm -f "$exe"
if ! command -v mhs >/dev/null 2>&1; then
  echo "error: mhs (MicroHs) is required" >&2
  exit 1
fi

# Build optc/optl args (mhs forwards these to the C compiler/linker too)
optc_args="-optc -I. -optc -ICompression -optc -IHsLua/src"
for d in $defines $gui_flag; do optc_args="$optc_args -optc $d"; done

mhs Arc \
  -tenvironment \
  -iCompression -icompat-ghc -icompat-oldtime -iHsLua/src \
  $defines $gui_flag \
  $optc_args \
  -o "$exe"

if [[ ! -f "$exe" ]]; then
  echo "error: build did not produce $exe" >&2
  exit 1
fi
[[ -s "$exe" ]] || { echo "error: $exe was produced but is empty" >&2; exit 1; }

# Check the output really is a Windows binary rather than trusting that the
# cross toolchain was wired up correctly: the first two bytes of a PE image are
# "MZ". Done inline because `file` is not installed everywhere -- and when it
# was missing this script exited 127 *after a successful build*, reporting
# failure for a binary that was sitting right there.
if [[ "$(head -c 2 "$exe")" != "MZ" ]]; then
  echo "error: $exe does not start with the MZ signature -- not a Windows executable" >&2
  exit 1
fi

# ...and that it is a Windows binary for the architecture that was *asked* for.
# "MZ" is identical for both targets, so a build that silently fell back to the
# host toolchain would pass every check above. `file` does name the
# architecture ("PE32+ executable (console) Aarch64"), but it is not installed
# everywhere -- the same reason the MZ check above is open-coded rather than
# shelling out to it. So read the PE machine field directly: the e_lfanew
# offset lives at 0x3c and the machine word is 4 bytes past the "PE\0\0"
# signature it points at.
case "$arch" in
  x86_64)  want_machine=0x8664; want_name="AMD64" ;;
  aarch64) want_machine=0xaa64; want_name="ARM64" ;;
esac
# Little-endian fields, assembled a byte at a time so this does not depend on
# the byte order of whatever host is doing the cross-compiling.
read_le () {  # read_le <byte-offset> <length> -> decimal value
  local byte value=0 shift_by=0
  for byte in $(od -An -tu1 -j "$1" -N "$2" "$exe"); do
    value=$(( value + byte * (1 << shift_by) )); shift_by=$(( shift_by + 8 ))
  done
  echo "$value"
}
got_machine=$(printf '0x%04x' "$(read_le $(( $(read_le 60 4) + 4 )) 2)")
if [[ "$got_machine" != "$want_machine" ]]; then
  echo "error: $exe is PE machine $got_machine, expected $want_machine ($want_name)" >&2
  exit 1
fi

echo ""
echo "Built: $exe ($(wc -c <"$exe" | tr -d ' ') bytes)"
command -v file >/dev/null 2>&1 && file "$exe"   # extra detail when available
exit 0
