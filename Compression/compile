#!/usr/bin/env bash
# Build every compression codec.
#
# This script previously ran `make` in each directory with no error checking
# at all, so a codec could fail to compile and the script would still exit 0.
# Combined with the same omission in the top-level compile script, that meant
# CI reported success for builds that produced no binary -- for months.
# Hence the strictness below: a failure anywhere must stop the build and be
# named.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
cd "$HERE"

CODECS=(
  External LZP REP Delta MM Tornado 4x4 Dict PPMD
  GRZip BSC DisPack Zstd 7z LZMA LZ4 _Encryption
)

fail () { echo "ERROR: $*" >&2; exit 1; }

# Common.o / CompressionLibrary.o first -- the codecs include their headers.
make || fail "failed to build Compression/ (Common.o, CompressionLibrary.o)"

for c in "${CODECS[@]}"; do
  [ -d "$c" ] || fail "codec directory missing: Compression/$c"
  make -C "$c" || fail "failed to build codec: Compression/$c"
done

echo "Compression: all ${#CODECS[@]} codecs built"
