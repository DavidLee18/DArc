#!/usr/bin/env bash
# Build every compression codec.
#
# This script previously ran `make` in each directory with no error checking
# at all, so a codec could fail to compile and the script would still exit 0.
# Combined with the same omission in the top-level compile script, that meant
# CI reported success for builds that produced no binary -- for months.
# Hence the strictness below: a failure anywhere must stop the build and be
# named.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
cd "$HERE"

CODECS=(
  External LZP REP Delta MM Tornado 4x4 Dict PPMD
  GRZip BSC DisPack Zstd LZMA LZ4 _Encryption
)

fail () { echo "ERROR: $*" >&2; exit 1; }

# Sanitizer flags arrive from the top-level compile script as DARC_DEBUG_FLAGS
# and override each makefile's own DEBUG_FLAGS. Passing it on the make command
# line is what gives it priority over the assignment inside the makefile.
#
# This is a function rather than an array of extra arguments because macOS
# still ships bash 3.2, where expanding an empty array under `set -u` is an
# "unbound variable" error rather than nothing at all. An earlier version used
# "${make_args[@]}" and broke the macOS build while working everywhere else.
run_make () {
  if [ -n "${DARC_DEBUG_FLAGS:-}" ]; then
    make "$@" DEBUG_FLAGS="$DARC_DEBUG_FLAGS"
  else
    make "$@"
  fi
}

# The object directory. The makefiles compile INTO $(TEMPDIR) and none of them
# creates it, so a tree where /tmp/out has been removed fails with
# "unable to open output file '/tmp/out/FreeArc/Common.o'" -- and removing
# /tmp/out is the documented remedy for the stale-object trap (CLAUDE.md: these
# makefiles do not rebuild when a -D changes), so the remedy broke the build it
# was meant to unbreak. Read TEMPDIR from common.mak rather than repeating the
# path, so the two cannot drift.
tempdir="$(sed -n 's/^TEMPDIR *= *//p' ../common.mak | tail -1)"
[ -n "$tempdir" ] || fail "no TEMPDIR in common.mak -- has a compile script run?"
mkdir -p "$tempdir" || fail "cannot create the object directory $tempdir"

# Common.o / CompressionLibrary.o first -- the codecs include their headers.
run_make || fail "failed to build Compression/ (Common.o, CompressionLibrary.o)"

for c in "${CODECS[@]}"; do
  [ -d "$c" ] || fail "codec directory missing: Compression/$c"
  run_make -C "$c" || fail "failed to build codec: Compression/$c"
done

echo "Compression: all ${#CODECS[@]} codecs built"
