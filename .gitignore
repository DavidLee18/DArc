# ./compile-ghc-probe's output. `Tests/*arc` does not match it -- the glob wants
# a name ENDING in "arc", and this one ends in "ghc".
Tests/arc-ghc
# Standalone SREP binary, produced by srep/compile (external compressor per arc.ini)
Tests/srep
# ...and the debug bundle a sanitizer build leaves beside it. `Tests/srep`
# does not match a `.dSYM` directory, so `git add -A` once swept 964 KB of
# DWARF into a commit.
Tests/*.dSYM/
common.mak
*_stub.h
*.comb
.mhscache
*.tar.gz

.DS_Store

# generated test corpus and scratch
Tests/corpus/
Tests/.work/

# Left in the working tree when arc dies mid-write (common while testing crashes)
$$temparc$$*.tmp
#.arc

# Cross-built Windows binaries
Tests/*.exe

# Rust build output
rust/*/target/

# Rust workspace build output
rust/target/
rust/darc-codecs/Cargo.lock

# Unarc build output: the standalone extractor, the SFX modules and the FAR
# plugin are all products of `cd Unarc && make`, not sources.
Unarc/unarc
Unarc/unarc.exe
Unarc/*.sfx
Unarc/FreeArc.fmt
Unarc/gui/res.o
