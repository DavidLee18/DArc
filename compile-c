#!/usr/bin/env bash
# Build the C side: the codec objects and everything Unarc links.
#
# This is what is left of ./compile after the Haskell layer was deleted. The
# archiver itself is now `cargo build --release -p darc-arc --bin darc`, and
# nothing here produces it.
#
# The reason this script still has to exist is `common.mak`. It is GENERATED,
# not committed -- every makefile under Compression/ begins with `include
# common.mak`, and until something copies the platform variant into place,
# `make` in a clean tree fails with no useful message.
#
# NOTE: since Unarc/ was deleted, NOTHING LINKS what this builds. The archiver
# and unarc are cargo binaries, and rust/difftest compiles its C oracles from a
# pinned SHA in git history rather than from this tree. This script survives
# only so a C-side syntax break is still noticed; it is a deletion candidate.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) src=win32-common.mak ;;
  *)                    src=unix-common.mak  ;;
esac
cp "$src" common.mak
echo "== common.mak <- $src"

# The staticlibs with the drop-in aliases. These existed so Unarc/ could link
# the Rust codecs through the C forwarders; Unarc/ is gone and no linker
# consumes them now. Kept because rust/check-dropin.sh still asserts the
# aliases are exported, and because a C forwarder that stopped compiling should
# fail here rather than silently.
echo "== Rust staticlibs"
( cd rust && cargo build --release -p darc-codecs -p darc-crypto -p darc-sevenz \
    --features darc-codecs/dropin )
bash rust/check-dropin.sh rust/target/release/libdarc_codecs.a

# Compiling every codec is the only check that the C still builds; nothing
# links these objects any more, since Unarc compiles its own from the same
# sources with -DFREEARC_DECOMPRESS_ONLY.
echo "== codecs"
export DARC_EXTRA_DEFINES="${DARC_EXTRA_DEFINES:--DDARC_RUST}"
( cd Compression && chmod +x compile && ./compile )

echo "C side built. The archiver is: cargo build --release -p darc-arc --bin darc"
