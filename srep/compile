#!/usr/bin/env bash
# Build standalone srep binary (SREP 3.93a beta, vendored from github.com/Intensity/srep).
# Output: ../Tests/srep, registered via arc.ini [External compressor:srep].
#
# This tree is NOT self-contained, despite what this comment used to claim. The
# headers live here (srep/Compression/, a diverged older vintage -- note
# BULAT_ZIGANSHIN_SIGNATURE is defined in srep/Compression/Compression.h and
# nowhere else), but the SREP sources themselves live in the repo-root
# Compression/SREP/. srep/Compression/SREP/ does not exist, so this script
# referred to a path that has never been present and the build failed
# immediately:
#
#   clang++: error: no such file or directory: 'Compression/SREP/srep.cpp'
#
# Which also means Tests/srep could not be produced, and the
# [External compressor:srep] entry in arc.ini could not work as shipped.
set -e

HERE="$(cd "$(dirname "$0")" && pwd)"
OUT="$HERE/../Tests/srep"

CXX="${CXX:-c++}"
# -msse2 is x86-only and -funroll-all-loops is a GCC spelling clang ignores;
# both are dropped on non-x86 so this builds on Apple Silicon and ARM Linux.
case "$(uname -m)" in
  x86_64|amd64) ARCHOPT="-mtune=generic -funroll-all-loops -msse2" ;;
  *)            ARCHOPT="" ;;
esac
OPT="${OPT:--O3 $ARCHOPT}"
DEF="-DFREEARC_UNIX -DFREEARC_INTEL_BYTE_ORDER -D_FILE_OFFSET_BITS=64"
# RUSAGE_THREAD is a glibc extension; macOS has only RUSAGE_SELF, and
# Common.cpp's only use of it is a per-thread CPU-time readout for statistics.
case "$(uname -s)" in
  Darwin) DEF="$DEF -DRUSAGE_THREAD=RUSAGE_SELF -I$HERE/compat" ;;
esac
INC="-I$HERE/Compression -I$HERE/Compression/_Encryption -I$HERE/Compression/_Encryption/headers -I$HERE/Compression/_Encryption/hashes"
WARN="-Wno-write-strings -Wno-unused-result -Wno-stringop-overflow -Wno-format-overflow"

cd "$HERE"
$CXX $OPT $DEF $INC $WARN \
  Compression/Common.cpp "$HERE/../Compression/SREP/srep.cpp" \
  -lpthread -lstdc++ \
  -o "$OUT"

echo "Built: $OUT"
