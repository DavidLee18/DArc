#!/usr/bin/env bash
# Cross-compile DArc to Windows x64 via Wine + GHC Windows bindist.
# Requirements:
#   - wine >= 8
#   - GHC Windows installed at ~/.wine/drive_c/ghc948/
#   - x86_64-w64-mingw32-g++-posix on host (for C/C++ side)
# Output: Tests/arc-win64.exe (real PE32+ Windows binary)
set -e

exe=Tests/arc-win64.exe
gui_flag=""
opt="-O2"
for option; do
  case $option in
    -DFREEARC_GUI) exe=Tests/freearc-win64.exe; gui_flag="-DFREEARC_GUI" ;;
    -O*) opt="$option" ;;
  esac
done

GHC_WIN_ROOT="${GHC_WIN_ROOT:-$HOME/.wine/drive_c/ghc948}"
if [[ ! -x "$GHC_WIN_ROOT/bin/ghc.exe" ]]; then
  echo "error: GHC Windows not found at $GHC_WIN_ROOT/bin/ghc.exe" >&2
  exit 1
fi

# 1) Build C/C++ objects for Win64
WINOUT="/tmp/out/FreeArc-win64-ghc"
export WINOUT
./compile-win64-c

# 1b) Build Win32Files.c (FFI stubs referenced by Win32Files.hs) against GHC's base include tree
HSBASE_INC="$GHC_WIN_ROOT/lib/x86_64-windows-ghc-9.4.8/base-4.17.2.1/include"
RTS_INC="$GHC_WIN_ROOT/lib/x86_64-windows-ghc-9.4.8/rts-1.0.2/include"
BIGNUM_INC="$GHC_WIN_ROOT/lib/x86_64-windows-ghc-9.4.8/ghc-bignum-1.3/include"
x86_64-w64-mingw32-gcc -c Win32Files.c \
  -I"$HSBASE_INC" -I"$RTS_INC" -I"$BIGNUM_INC" -O2 \
  -o "$WINOUT/Win32Files.o"

# 2) Build ntrljmp.c for Win64 (Lua-related trampoline) — skip for now, not critical

# 3) Run GHC Windows via Wine
htempdir="/tmp/out/FreeArc-win64-ghc-hs"
mkdir -p "$htempdir"

# Wine path: tempdir and obj list need to be wine-visible (drive letter or Z:\... for /)
# Z: maps to /, so /tmp/out/... -> Z:\tmp\out\...
winpath() {
  # Convert /absolute/path to Z:\\absolute\\path
  local p="$1"
  # Replace / with \ and prefix Z:
  echo "Z:$(echo "$p" | sed 's|/|\\|g')"
}

c_objs=(
  "$WINOUT/Environment.o" "$WINOUT/URL.o" "$WINOUT/Common.o"
  "$WINOUT/CompressionLibrary.o"
  "$WINOUT/C_PPMD.o" "$WINOUT/C_LZP.o" "$WINOUT/C_LZMA.o"
  "$WINOUT/C_GRZip.o" "$WINOUT/C_Dict.o" "$WINOUT/C_REP.o"
  "$WINOUT/C_MM.o" "$WINOUT/C_TTA.o" "$WINOUT/C_Tornado.o"
  "$WINOUT/C_4x4.o" "$WINOUT/C_Delta.o" "$WINOUT/C_External.o"
  "$WINOUT/C_Encryption.o"
  "$WINOUT/Win32Files.o"
  "$WINOUT/ntrljmp.o"
)
[[ -f "$WINOUT/C_BCJ.o" ]] && c_objs+=("$WINOUT/C_BCJ.o")
[[ -n $gui_flag && -f "$WINOUT/GuiEnvironment.o" ]] && c_objs+=("$WINOUT/GuiEnvironment.o")

# Windows system libs (MinGW provides these under GHC's mingw dir)
win_libs=(-L"$(winpath "$WINOUT")" -llua5.1 -lstdc++ -lpthread -lwinmm -lws2_32 -ladvapi32 -lshell32 -luser32 -lkernel32)

# Haskell CPP defines
hs_defines=(-DFREEARC_WIN -DFREEARC_INTEL_BYTE_ORDER -DFREEARC_64BIT -DFREEARC_NOURL)
[[ -n $gui_flag ]] && hs_defines+=("$gui_flag")

ghc_ext_flags=(
  -XNoMonomorphismRestriction -XFlexibleContexts -XScopedTypeVariables
  -XTypeSynonymInstances -XFlexibleInstances -XMultiParamTypeClasses -XCPP
  -XNondecreasingIndentation -XUndecidableInstances -XOverlappingInstances
  -XLambdaCase -XBangPatterns -XRecursiveDo -XTupleSections
)

# optl args (one -optl per token)
optl_args=()
for o in "${c_objs[@]}"; do
  optl_args+=(-optl "$(winpath "$(readlink -f "$o")")")
done
for l in "${win_libs[@]}"; do optl_args+=(-optl "$l"); done

# optc args for any C files GHC might compile directly (FFI stubs, etc.)
optc_args=(-optc -I. -optc -ICompression -optc -IHsLua/src -optc -I/tmp/out/FreeArc-win64-ghc-inc/lua5.1 -optc -I/tmp/out/FreeArc-win64-ghc-inc)
for d in "${hs_defines[@]}"; do optc_args+=(-optc "$d"); done

rm -f "$exe"

# Run GHC under Wine. Use Z: drive (Wine maps / to Z:)
# Work in the DArc source dir which is visible via Z:
DARC_DIR="$(pwd)"
DARC_WIN="$(winpath "$(readlink -f "$DARC_DIR")")"
HTEMP_WIN="$(winpath "$htempdir")"

# Suppress wine fixme noise
export WINEDEBUG="${WINEDEBUG:-fixme-all}"
export WINEPATH="C:\\ghc948\\mingw\\bin"

# Build inside the source dir. GHC --make resolves paths relative to CWD.
cd "$DARC_DIR"

wine "$GHC_WIN_ROOT/bin/ghc.exe" \
  -i. -iCompression -iHsLua/src -icompat-win \
  -odir "$HTEMP_WIN" -hidir "$HTEMP_WIN" \
  $opt -threaded \
  "${hs_defines[@]}" \
  "${optc_args[@]}" \
  "${ghc_ext_flags[@]}" \
  -fno-warn-deprecated-flags -w \
  "${optl_args[@]}" \
  --make Arc.hs \
  -main-is Arc \
  -o "$(winpath "$(readlink -f "$exe" 2>/dev/null || echo "$DARC_DIR/$exe")")" 2>&1 \
  | grep -vE "^[0-9a-f]+:fixme:|^[0-9a-f]+:stub|server_get_file_info|NtQuerySystemInformation" || true

if [[ -f "$exe" ]]; then
  echo ""
  echo "Built: $exe"
  file "$exe"
else
  echo "error: build did not produce $exe" >&2
  exit 1
fi
