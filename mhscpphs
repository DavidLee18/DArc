#!/usr/bin/env python3
"""Streaming CPP replacement for MicroHs that handles large files."""
import sys, re

def eval_cpp_cond(cond, defs):
    cond = re.sub(r'!\s*defined\s*\(\s*(\w+)\s*\)', 
                  lambda mo: '0' if mo.group(1) in defs else '1', cond)
    cond = re.sub(r'defined\s*\(\s*(\w+)\s*\)',
                  lambda mo: '1' if mo.group(1) in defs else '0', cond)
    for k, v in defs.items():
        cond = re.sub(r'\b' + re.escape(k) + r'\b', v or '1', cond)
    cond = re.sub(r'\b[A-Za-z_]\w*\b', '0', cond)
    cond = cond.replace('&&', ' and ').replace('||', ' or ').replace('!', ' not ')
    try:
        return bool(eval(cond))
    except:
        return False

def process_file(infile, outfile, defines):
    defs = {}
    for d in defines:
        if '=' in d:
            k, v = d.split('=', 1)
            defs[k] = v
        else:
            defs[d] = '1'
    include_stack = [True]
    def cur_include():
        return all(include_stack)
    with open(infile, 'r', errors='replace') as fin, open(outfile, 'w') as fout:
        for line in fin:
            stripped = line.rstrip('\n')
            m = re.match(r'^\s*#\s*(\w+)(.*)', stripped)
            if m:
                directive = m.group(1)
                rest = m.group(2).strip()
                if directive == 'if':
                    include_stack.append(cur_include() and eval_cpp_cond(rest, defs))
                elif directive == 'ifdef':
                    include_stack.append(cur_include() and (rest.strip() in defs))
                elif directive == 'ifndef':
                    include_stack.append(cur_include() and (rest.strip() not in defs))
                elif directive == 'elif':
                    include_stack.pop()
                    include_stack.append(cur_include() and eval_cpp_cond(rest, defs))
                elif directive == 'else':
                    val = include_stack.pop()
                    parent_active = all(include_stack)
                    include_stack.append(parent_active and not val)
                elif directive == 'endif':
                    if len(include_stack) > 1:
                        include_stack.pop()
                elif directive == 'define' and cur_include():
                    m2 = re.match(r'(\w+)(?:\([^)]*\))?\s*(.*)', rest)
                    if m2:
                        defs[m2.group(1)] = m2.group(2)
                elif directive == 'undef' and cur_include():
                    defs.pop(rest.strip(), None)
                fout.write('\n')
            else:
                if cur_include():
                    out = stripped
                    for k, v in defs.items():
                        if v and v != '1' and re.match(r'^[a-zA-Z_]\w*$', k):
                            out = re.sub(r'\b' + re.escape(k) + r'\b', v, out)
                    # Truncate huge line comments to avoid mhs heap exhaustion
                    if len(out) > 2000 and '--' in out:
                        idx = out.index('--')
                        out = out[:idx].rstrip()
                    fout.write(out + '\n')
                else:
                    fout.write('\n')

if __name__ == '__main__':
    args = sys.argv[1:]
    defines = []
    infile = None
    outfile = None
    i = 0
    while i < len(args):
        a = args[i]
        if a in ('--strip',):
            pass
        elif a.startswith('-D'):
            defines.append(a[2:])
        elif a.startswith('-I'):
            pass
        elif a.startswith('-O'):
            outfile = a[2:]
        elif not a.startswith('-'):
            infile = a
        i += 1
    if not infile or not outfile:
        sys.exit(1)
    process_file(infile, outfile, defines)
