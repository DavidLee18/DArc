exe=Tests/arc
for option; do if [[ $option == -DFREEARC_GUI ]]; then exe=Tests/freearc; fi; done
ctempdir=/tmp/out/FreeArc
tempdir=$ctempdir$1$2$3
mkdir -p $tempdir
mkdir -p $ctempdir
if [ "$(getconf LONG_BIT 2>/dev/null)" = "64" ]; then
  bit64="-DFREEARC_64BIT"
else
  bit64=""
fi
defines="-DFREEARC_UNIX -DFREEARC_INTEL_BYTE_ORDER $bit64"
# ******** -DFREEARC_WIN -DFREEARC_MOTOROLA_BYTE_ORDER -DFREEARC_ONLY_ALIGNED_ACCESS *******
cp unix-common.mak common.mak
cd Compression
chmod +x compile
./compile
cd ..
make ALL
lua_libs=$(pkg-config --libs lua5.1 2>/dev/null || echo "-llua5.1")
if pkg-config --exists libcurl 2>/dev/null; then
  curl_libs=$(pkg-config --libs libcurl)
else
  curl_libs=""
  defines="$defines -DFREEARC_NOURL"
fi
clang -c HsLua/src/ntrljmp.c -IHsLua/src $(pkg-config --cflags lua5.1 2>/dev/null) -o $ctempdir/ntrljmp.o
clang -c compat/posix_compat.c -o $ctempdir/posix_compat.o
rm $exe
c_objs="$ctempdir/Environment.o $ctempdir/URL.o $ctempdir/Common.o $ctempdir/CompressionLibrary.o $ctempdir/C_PPMD.o $ctempdir/C_LZP.o $ctempdir/C_LZMA.o $ctempdir/C_BCJ.o $ctempdir/C_GRZip.o $ctempdir/C_Dict.o $ctempdir/C_REP.o $ctempdir/C_MM.o $ctempdir/C_TTA.o $ctempdir/C_Tornado.o $ctempdir/C_Delta.o $ctempdir/C_External.o $ctempdir/C_Encryption.o $ctempdir/ntrljmp.o $ctempdir/posix_compat.o"
c_libs="-lstdc++ -lncurses $curl_libs $lua_libs"
for option; do if [[ $option == -DFREEARC_GUI ]]; then c_objs="$c_objs $ctempdir/GuiEnvironment.o"; fi; done
mhs_args=()
for option; do
    case $option in
        -O*) ;; # Skip C optimization flags; mhs already uses -O3 via targets.conf
        *) mhs_args+=("$option") ;;
    esac
done
# Build mhs optl and optc args from c_objs and c_libs
mhs_link_args=()
for obj in $c_objs; do mhs_link_args+=("$obj"); done
for lib in $c_libs; do mhs_link_args+=("-optl" "$lib"); done
mhs_inc_args=("-optc" "-IHsLua/src" "-optc" "-I." "-optc" "-ICompression" \
              "-optc" "-Dmhs_to_Int64=mhs_to_Int" "-optc" "-Dmhs_from_Int64=mhs_from_Int" \
              "-optc" "$(pkg-config --cflags lua5.1 2>/dev/null || echo '-I/usr/include/lua5.1')")
MHSCPPHS=./mhscpphs mhs "${mhs_args[@]}" -icompat -iCompression -iHsLua/src -XCPP $defines "${mhs_link_args[@]}" "${mhs_inc_args[@]}" -o $exe Arc.hs
rm -f Compression/CompressionLib_stub.?
